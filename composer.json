{
  "name": "waas-api/api-sdk-php",
  "description": "waas api",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "WaasApi\\ApiSdkPhp\\": "src/"
    }
  },
  "require": {
    "php": ">=5.6",
    "ext-curl": "*",
    "ext-openssl": "*",
    "paragonie/random_compat": "^2.0.21",
    "paragonie/sodium_compat": "^1.21"
  },
  "suggest": {
    "ext-sodium": "Accelerates Travel Rule Ed25519 and NaCl box; sodium_compat is used without it",
    "ext-redis": "Shared atomic callback nonce storage"
  },
  "scripts": {
    "test": "php tests/run.php"
  }
}
